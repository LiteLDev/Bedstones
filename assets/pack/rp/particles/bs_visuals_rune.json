            "minecraft:particle_appearance_tinting": { "color": ["v.bs_r * (1 - math.abs(v.particle_age / (v.particle_lifetime * 0.5) - 1))", "v.bs_g * (1 - math.abs(v.particle_age / (v.particle_lifetime * 0.5) - 1))", "v.bs_b * (1 - math.abs(v.particle_age / (v.particle_lifetime * 0.5) - 1))", "1 - math.abs(v.particle_age / (v.particle_lifetime * 0.5) - 1)"] }
        }
