            "minecraft:particle_motion_dynamic": {},
            "minecraft:particle_appearance_billboard": {
                "size": [0.25, 0.5],
                "facing_camera_mode": "direction_z",
                "direction": { "mode": "custom", "custom_direction": ["v.bs_nx", 0, "v.bs_nz"] },
                "uv": { "texture_width": 24, "texture_height": 16, "uv": ["v.bs_u", 0], "uv_size": [8, 16] }
